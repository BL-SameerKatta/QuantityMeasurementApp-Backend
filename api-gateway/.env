# Render Port is automatically assigned, but we default to 8080 locally
PORT=8080

# For Render Deployment: Set this environment variable in the Render Dashboard to your deployed Eureka Server URL
# Example: EUREKA_SERVER_URL=https://your-eureka-server.onrender.com/eureka/
EUREKA_SERVER_URL=http://localhost:8761/eureka/

APP_NAME=api-gateway
QUANTITY_ROUTE_ID=quantity-service
QUANTITY_ROUTE_URI=lb://quantity-measurement-service
QUANTITY_ROUTE_PATH=/quantity/**
AUTH_ROUTE_ID=auth-service
AUTH_ROUTE_URI=lb://auth-service
AUTH_ROUTE_PATH=/auth/**
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=*
CORS_ALLOWED_HEADERS=*
